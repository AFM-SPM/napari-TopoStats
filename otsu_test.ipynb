    "from topostats.utils import get_thresholds, get_mask\n",
    "import numpy as np\n",
    "\n",
    "img = np.random.rand(10, 10)\n",
    "thresholds = get_thresholds(image = img, threshold_method = \"otsu\", otsu_threshold_multiplier = 1.0)\n",
    "get_mask(image=img, thresholds=thresholds)"
   ]
  }
